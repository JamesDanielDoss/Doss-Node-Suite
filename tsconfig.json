{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "web",
    "outDir": "js",
    "declaration": false,
    "removeComments": false,
    "noEmitOnError": true
  },
  "include": ["web/**/*.ts"]
}
